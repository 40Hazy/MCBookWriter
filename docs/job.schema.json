{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcbookwriter.local/job.schema.json",
  "title": "BookForge job manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "titleBase", "pageLimit", "sourceHash", "segments"],
  "properties": {
    "version": {
      "const": 1
    },
    "titleBase": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24
    },
    "pageLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "sourceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stripFormatting": {
          "type": "boolean"
        },
        "llmApplied": {
          "type": "boolean"
        },
        "pageLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "breakAtSentence": {
          "type": "boolean"
        },
        "verifyContent": {
          "type": "boolean"
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "text"],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "chapter": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
